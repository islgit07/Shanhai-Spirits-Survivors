# 统一行尾：仓库内一律 LF，工作区检出也是 LF。
# 本机 core.autocrlf=true 曾导致 git 反复提示
#   "LF will be replaced by CRLF the next time Git touches it"
# 并让 .tscn / .cs 在工作区出现 CRLF 与 LF 混用。
* text=auto eol=lf

# Godot 文本资源
*.gd text eol=lf
*.gdshader text eol=lf
*.gdshaderinc text eol=lf
*.tscn text eol=lf
*.tres text eol=lf
*.godot text eol=lf
*.cfg text eol=lf
*.import text eol=lf
*.uid text eol=lf
*.gdignore text eol=lf

# C# / 工具链
*.cs text eol=lf
*.csproj text eol=lf
*.sln text eol=lf
*.py text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf

# 二进制资源：不 diff、不合并、不做行尾转换
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.svg binary
*.psd binary
*.aseprite binary
*.wav binary
*.ogg binary
*.mp3 binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.glb binary
*.gltf binary
*.blend binary
*.fbx binary
*.mp4 binary
*.ogv binary
